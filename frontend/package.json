{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-static-pages.mjs && node scripts/generate-how-we-grade-page.mjs && node scripts/generate-author-pages.mjs && node scripts/generate-skill-pages.mjs && node scripts/generate-sub-skill-pages.mjs && node scripts/generate-skill-redirects.mjs && node scripts/generate-audit-pages.mjs && node scripts/generate-scenario-pages.mjs && node scripts/generate-home-zh.mjs && node scripts/generate-comparison-pages.mjs && node scripts/generate-book-pages.mjs && node scripts/generate-badges.mjs && node scripts/generate-rss.mjs && node scripts/generate-daily-pages.mjs && node scripts/generate-search-index.mjs && node scripts/generate-stats-page.mjs && node scripts/generate-directories-page.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-llms-txt.mjs",
    "build:check": "tsc -b && vite build --emptyOutDir false",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:scenarios": "node scripts/test-scenarios.mjs",
    "test:redirects": "node --test scripts/skill-redirects.test.mjs",
    "test:sitemap": "node --test scripts/sitemap-index.test.mjs",
    "test:indexnow": "node --test scripts/indexnow-changes.test.mjs",
    "test:modified": "node --test scripts/scenario-modified.test.mjs",
    "test:home-lists": "node --test scripts/home-lists.test.mjs",
    "test:skill-copy": "node --test scripts/skill-page-copy.test.mjs",
    "test:home-counts": "node --test scripts/home-counts.test.mjs",
    "test:agent-file-counts": "node --test scripts/agent-file-counts.test.mjs",
    "test:guides": "node --test scripts/skill-guides.test.mjs",
    "test:featured": "node --test scripts/featured-repos.test.mjs",
    "test:states": "node --test scripts/quick-search-state.test.mjs scripts/skill-page-state.test.mjs scripts/pro-search-state.test.mjs",
    "test:directories": "node --test scripts/directories-content.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.98.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
